function assign_int (choice)
{
  let lower_choice = choice.toLowerCase();
  switch (lower_choice)
  {
    case "rock":
      return 1;
    case "paper":
      return 2;
    case "scissors":
      return 3;
    default:
      console.log("Make sure you entered either \"rock\", \"paper\", or \"scissors\"\n.");
      return -1;
  }
}

